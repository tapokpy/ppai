# Telegram
BOT_TOKEN=
ADMIN_IDS=123456789,987654321

# Local LLM (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Cloud LLM (Anthropic Claude)
ANTHROPIC_API_KEY=
CLOUD_MODEL_NAME=claude-3-5-sonnet-20241022
CLOUD_DAILY_LIMIT_PER_USER=50

# VPN / Egress Proxy (Gluetun + Mullvad) - Anthropic Claude calls only.
# Left empty for local (non-Docker) dev. docker-compose.yml sets this
# automatically to http://gluetun:8888 for the api/bot containers.
ANTHROPIC_PROXY_URL=

# Mullvad WireGuard credentials for Gluetun - consumed ONLY by docker-compose.yml
# (Compose variable interpolation), NOT read by the Python app/Settings class.
# See VPN_DEPLOYMENT.md for how to obtain these.
MULLVAD_WIREGUARD_PRIVATE_KEY=
MULLVAD_WIREGUARD_ADDRESSES=
MULLVAD_SERVER_COUNTRIES=Sweden

# RAG
RAG_SCORE_THRESHOLD=0.65
CHROMA_PERSIST_DIR=./data/chroma_db
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Database
POSTGRES_DSN=postgresql+asyncpg://ppai:ppai@localhost:5432/ppai
REDIS_URL=redis://localhost:6379/0

# Observability
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Security
SECRET_KEY=change-me-in-production
INTERNAL_API_TOKEN=change-me-internal-token
JWT_ALGORITHM=HS256
JWT_EXPIRES_HOURS=8
OTT_EXPIRES_SECONDS=300
