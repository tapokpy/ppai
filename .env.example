# --- PostgreSQL ---
POSTGRES_USER=pridprom
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pridprom

# --- Redis ---
REDIS_PASSWORD=changeme

# --- Ollama ---
OLLAMA_MODEL=qwen2.5:7b

# --- Anthropic Claude (облачный уровень каскада) ---
ANTHROPIC_API_KEY=

# --- Telegram-бот ---
TELEGRAM_BOT_TOKEN=

# --- RAG ---
RAG_SCORE_THRESHOLD=0.65

# --- Langfuse (опционально, можно использовать Langfuse Cloud) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Gluetun / Mullvad VPN ---
# WireGuard-ключи берутся в личном кабинете Mullvad после генерации конфига
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
VPN_SERVER_COUNTRIES=Netherlands
# подсеть docker-сети app_net, нужна gluetun для firewall-правил
DOCKER_SUBNET=172.28.0.0/16

# --- Порт, на котором backend доступен снаружи (публикуется через gluetun) ---
BACKEND_PORT=8000
